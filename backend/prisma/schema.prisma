// ==============================================================================
// PharmaPOS Prisma Schema for MySQL / MariaDB (XAMPP Environment)
// Provider: mysql
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------------------
// 1. RBAC & Multi-Branch Management
// ------------------------------------------------------------------------------

model Branch {
  id                 String              @id @default(uuid()) @db.VarChar(36)
  code               String              @unique @db.VarChar(20)
  name               String              @db.VarChar(100)
  address            String?             @db.Text
  phone              String?             @db.VarChar(20)
  isActive           Boolean             @default(true) @map("is_active")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  users              User[]
  inventories        Inventory[]
  inventoryMovements InventoryMovement[]
  sales              Sale[]
  purchases          Purchase[]
  prescriptions      Prescription[]
  notifications      Notification[]
  aiPredictions      AiPrediction[]

  @@map("branches")
}

model Role {
  id          String           @id @default(uuid()) @db.VarChar(36)
  name        String           @unique @db.VarChar(50)
  description String?          @db.VarChar(255)
  isSystem    Boolean          @default(true) @map("is_system")

  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id     String           @id @default(uuid()) @db.VarChar(36)
  code   String           @unique @db.VarChar(100)
  name   String           @db.VarChar(100)
  module String           @db.VarChar(50)

  roles  RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.VarChar(36)
  permissionId String     @map("permission_id") @db.VarChar(36)

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id                 String              @id @default(uuid()) @db.VarChar(36)
  branchId           String              @map("branch_id") @db.VarChar(36)
  roleId             String              @map("role_id") @db.VarChar(36)
  name               String              @db.VarChar(100)
  email              String              @unique @db.VarChar(100)
  passwordHash       String              @map("password_hash") @db.VarChar(255)
  phone              String?             @db.VarChar(20)
  isActive           Boolean             @default(true) @map("is_active")
  lastLoginAt        DateTime?           @map("last_login_at")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  branch             Branch              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  role               Role                @relation(fields: [roleId], references: [id], onDelete: Restrict)

  inventoryMovements InventoryMovement[]
  sales              Sale[]
  purchases          Purchase[]
  verifiedPrescripts Prescription[]
  notifications      Notification[]
  auditLogs          AuditLog[]

  @@index([branchId])
  @@index([roleId])
  @@map("users")
}

// ------------------------------------------------------------------------------
// 2. Master Data: Customers, Suppliers, Categories, Products & Batches
// ------------------------------------------------------------------------------

model Customer {
  id            String         @id @default(uuid()) @db.VarChar(36)
  name          String         @db.VarChar(100)
  phone         String         @unique @db.VarChar(20)
  email         String?        @db.VarChar(100)
  address       String?        @db.Text
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  sales         Sale[]
  prescriptions Prescription[]

  @@map("customers")
}

model Supplier {
  id             String         @id @default(uuid()) @db.VarChar(36)
  code           String         @unique @db.VarChar(20)
  name           String         @db.VarChar(100)
  companyName    String         @map("company_name") @db.VarChar(150)
  phone          String         @db.VarChar(20)
  email          String?        @db.VarChar(100)
  address        String?        @db.Text
  isActive       Boolean        @default(true) @map("is_active")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  productBatches ProductBatch[]
  purchases      Purchase[]

  @@map("suppliers")
}

model Category {
  id          String    @id @default(uuid()) @db.VarChar(36)
  name        String    @unique @db.VarChar(100)
  description String?   @db.VarChar(255)
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  products    Product[]

  @@map("categories")
}

model Product {
  id                     String              @id @default(uuid()) @db.VarChar(36)
  categoryId             String              @map("category_id") @db.VarChar(36)
  sku                    String              @unique @db.VarChar(50)
  barcode                String              @unique @db.VarChar(50)
  name                   String              @db.VarChar(150)
  genericName            String?             @map("generic_name") @db.VarChar(150)
  brand                  String?             @db.VarChar(100)
  dosageForm             String              @map("dosage_form") @db.VarChar(50)
  dosage                 String?             @db.VarChar(50)
  unit                   String              @db.VarChar(30)
  buyPrice               Decimal             @default(0.00) @map("buy_price") @db.Decimal(12, 2)
  sellPrice              Decimal             @default(0.00) @map("sell_price") @db.Decimal(12, 2)
  minStock               Int                 @default(10) @map("min_stock")
  maxStock               Int                 @default(500) @map("max_stock")
  isPrescriptionRequired Boolean             @default(false) @map("is_prescription_required")
  isActive               Boolean             @default(true) @map("is_active")
  createdAt              DateTime            @default(now()) @map("created_at")
  updatedAt              DateTime            @updatedAt @map("updated_at")

  category               Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  batches                ProductBatch[]
  inventories            Inventory[]
  inventoryMovements     InventoryMovement[]
  saleItems              SaleItem[]
  purchaseItems          PurchaseItem[]
  prescriptionItems      PrescriptionItem[]
  promotionProducts      PromotionProduct[]
  aiPredictions          AiPrediction[]

  @@index([categoryId])
  @@index([name])
  @@map("products")
}

model ProductBatch {
  id                 String              @id @default(uuid()) @db.VarChar(36)
  productId          String              @map("product_id") @db.VarChar(36)
  supplierId         String?             @map("supplier_id") @db.VarChar(36)
  batchNumber        String              @map("batch_number") @db.VarChar(50)
  mfgDate            DateTime            @map("mfg_date") @db.Date
  expDate            DateTime            @map("exp_date") @db.Date
  initialQuantity    Int                 @map("initial_quantity")
  currentQuantity    Int                 @map("current_quantity")
  buyPrice           Decimal             @map("buy_price") @db.Decimal(12, 2)
  status             String              @default("ACTIVE") @db.VarChar(20)
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  product            Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  supplier           Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  inventoryMovements InventoryMovement[]
  saleItems          SaleItem[]

  @@index([productId])
  @@index([expDate])
  @@map("product_batches")
}

// ------------------------------------------------------------------------------
// 3. Inventory & Movements (FEFO Audit Trail)
// ------------------------------------------------------------------------------

model Inventory {
  id            String   @id @default(uuid()) @db.VarChar(36)
  branchId      String   @map("branch_id") @db.VarChar(36)
  productId     String   @map("product_id") @db.VarChar(36)
  totalStock    Int      @default(0) @map("total_stock")
  reservedStock Int      @default(0) @map("reserved_stock")
  updatedAt     DateTime @updatedAt @map("updated_at")

  branch        Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  product       Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([branchId, productId], name: "branch_product_unique")
  @@map("inventory")
}

model InventoryMovement {
  id            String        @id @default(uuid()) @db.VarChar(36)
  branchId      String        @map("branch_id") @db.VarChar(36)
  productId     String        @map("product_id") @db.VarChar(36)
  batchId       String?       @map("batch_id") @db.VarChar(36)
  type          String        @db.VarChar(30) // PURCHASE_RECEIVE, SALE, STOCK_ADJUSTMENT, RETURN, EXPIRED_DISCARD
  quantity      Int
  previousStock Int           @map("previous_stock")
  finalStock    Int           @map("final_stock")
  referenceId   String?       @map("reference_id") @db.VarChar(100)
  notes         String?       @db.Text
  createdBy     String        @map("created_by") @db.VarChar(36)
  createdAt     DateTime      @default(now()) @map("created_at")

  branch        Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  batch         ProductBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  creator       User          @relation(fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([productId])
  @@index([createdAt])
  @@map("inventory_movements")
}

// ------------------------------------------------------------------------------
// 4. Sales, Sale Items & Payments (POS)
// ------------------------------------------------------------------------------

model Sale {
  id             String     @id @default(uuid()) @db.VarChar(36)
  invoiceNumber  String     @unique @map("invoice_number") @db.VarChar(50)
  branchId       String     @map("branch_id") @db.VarChar(36)
  customerId     String?    @map("customer_id") @db.VarChar(36)
  cashierId      String     @map("cashier_id") @db.VarChar(36)
  subtotal       Decimal    @default(0.00) @db.Decimal(12, 2)
  discountAmount Decimal    @default(0.00) @map("discount_amount") @db.Decimal(12, 2)
  taxAmount      Decimal    @default(0.00) @map("tax_amount") @db.Decimal(12, 2)
  totalAmount    Decimal    @default(0.00) @map("total_amount") @db.Decimal(12, 2)
  paymentStatus  String     @default("PAID") @map("payment_status") @db.VarChar(20)
  paymentMethod  String     @default("TUNAI") @map("payment_method") @db.VarChar(30)
  notes          String?    @db.Text
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  branch         Branch     @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customer       Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  cashier        User       @relation(fields: [cashierId], references: [id], onDelete: Restrict)
  items          SaleItem[]
  payments       Payment[]

  @@index([branchId])
  @@index([createdAt])
  @@map("sales")
}

model SaleItem {
  id             String       @id @default(uuid()) @db.VarChar(36)
  saleId         String       @map("sale_id") @db.VarChar(36)
  productId      String       @map("product_id") @db.VarChar(36)
  batchId        String       @map("batch_id") @db.VarChar(36)
  quantity       Int
  unitPrice      Decimal      @map("unit_price") @db.Decimal(12, 2)
  discountAmount Decimal      @default(0.00) @map("discount_amount") @db.Decimal(12, 2)
  subtotal       Decimal      @db.Decimal(12, 2)

  sale           Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product        Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  batch          ProductBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@map("sale_items")
}

model Payment {
  id            String   @id @default(uuid()) @db.VarChar(36)
  saleId        String   @map("sale_id") @db.VarChar(36)
  paymentNumber String   @unique @map("payment_number") @db.VarChar(50)
  method        String   @db.VarChar(30) // TUNAI, QRIS, DEBIT, TRANSFER, EWALLET
  amount        Decimal  @db.Decimal(12, 2)
  status        String   @default("PAID") @db.VarChar(20)
  referenceCode String?  @map("reference_code") @db.VarChar(100)
  paidAt        DateTime @default(now()) @map("paid_at")

  sale          Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@map("payments")
}

// ------------------------------------------------------------------------------
// 5. Purchases & Suppliers (Pengadaan)
// ------------------------------------------------------------------------------

model Purchase {
  id           String         @id @default(uuid()) @db.VarChar(36)
  poNumber     String         @unique @map("po_number") @db.VarChar(50)
  branchId     String         @map("branch_id") @db.VarChar(36)
  supplierId   String         @map("supplier_id") @db.VarChar(36)
  orderDate    DateTime       @map("order_date") @db.Date
  expectedDate DateTime?      @map("expected_date") @db.Date
  totalAmount  Decimal        @default(0.00) @map("total_amount") @db.Decimal(12, 2)
  status       String         @default("ORDERED") @db.VarChar(30) // DRAFT, ORDERED, RECEIVED, CANCELLED
  notes        String?        @db.Text
  createdBy    String         @map("created_by") @db.VarChar(36)
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  branch       Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  supplier     Supplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  creator      User           @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  items        PurchaseItem[]

  @@index([branchId])
  @@index([supplierId])
  @@map("purchases")
}

model PurchaseItem {
  id               String   @id @default(uuid()) @db.VarChar(36)
  purchaseId       String   @map("purchase_id") @db.VarChar(36)
  productId        String   @map("product_id") @db.VarChar(36)
  quantity         Int
  unitPrice        Decimal  @map("unit_price") @db.Decimal(12, 2)
  subtotal         Decimal  @db.Decimal(12, 2)
  receivedQuantity Int      @default(0) @map("received_quantity")

  purchase         Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product          Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([purchaseId])
  @@map("purchase_items")
}

// ------------------------------------------------------------------------------
// 6. Prescriptions (Resep & Apoteker)
// ------------------------------------------------------------------------------

model Prescription {
  id                 String             @id @default(uuid()) @db.VarChar(36)
  prescriptionNumber String             @unique @map("prescription_number") @db.VarChar(50)
  branchId           String             @map("branch_id") @db.VarChar(36)
  customerId         String             @map("customer_id") @db.VarChar(36)
  doctorName         String             @map("doctor_name") @db.VarChar(100)
  doctorSip          String?            @map("doctor_sip") @db.VarChar(50)
  prescriptionDate   DateTime           @map("prescription_date") @db.Date
  pharmacistId       String?            @map("pharmacist_id") @db.VarChar(36)
  status             String             @default("PENDING") @db.VarChar(30) // PENDING, VERIFIED, DISPENSED, REJECTED
  notes              String?            @db.Text
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  branch             Branch             @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customer           Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  pharmacist         User?              @relation(fields: [pharmacistId], references: [id], onDelete: SetNull)
  items              PrescriptionItem[]

  @@index([branchId])
  @@index([customerId])
  @@map("prescriptions")
}

model PrescriptionItem {
  id                 String       @id @default(uuid()) @db.VarChar(36)
  prescriptionId     String       @map("prescription_id") @db.VarChar(36)
  productId          String       @map("product_id") @db.VarChar(36)
  dosage             String?      @db.VarChar(50)
  dosageInstructions String       @map("dosage_instructions") @db.VarChar(100)
  quantity           Int
  isDispensed        Boolean      @default(false) @map("is_dispensed")

  prescription       Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  product            Product      @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([prescriptionId])
  @@map("prescription_items")
}

// ------------------------------------------------------------------------------
// 7. Promotions & Discounts
// ------------------------------------------------------------------------------

model Promotion {
  id          String             @id @default(uuid()) @db.VarChar(36)
  code        String             @unique @db.VarChar(50)
  name        String             @db.VarChar(100)
  type        String             @db.VarChar(30) // PERCENTAGE, FIXED, MIN_PURCHASE, BUNDLE
  value       Decimal            @db.Decimal(12, 2)
  minPurchase Decimal            @default(0.00) @map("min_purchase") @db.Decimal(12, 2)
  startDate   DateTime           @map("start_date") @db.Date
  endDate     DateTime           @map("end_date") @db.Date
  isActive    Boolean            @default(true) @map("is_active")
  createdAt   DateTime           @default(now()) @map("created_at")

  products    PromotionProduct[]

  @@map("promotions")
}

model PromotionProduct {
  promotionId String    @map("promotion_id") @db.VarChar(36)
  productId   String    @map("product_id") @db.VarChar(36)

  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([promotionId, productId])
  @@map("promotion_products")
}

// ------------------------------------------------------------------------------
// 8. Notifications, Audit Logs & AI Analytics
// ------------------------------------------------------------------------------

model Notification {
  id        String   @id @default(uuid()) @db.VarChar(36)
  branchId  String   @map("branch_id") @db.VarChar(36)
  userId    String?  @map("user_id") @db.VarChar(36)
  title     String   @db.VarChar(150)
  message   String   @db.Text
  type      String   @db.VarChar(30) // LOW_STOCK, NEAR_EXPIRY, PO_RECEIVED, AI_ALERT
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([branchId])
  @@map("notifications")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.VarChar(36)
  userId      String?  @map("user_id") @db.VarChar(36)
  action      String   @db.VarChar(50)
  entity      String   @db.VarChar(50)
  entityId    String?  @map("entity_id") @db.VarChar(36)
  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  detailsJson String?  @map("details_json") @db.LongText
  createdAt   DateTime @default(now()) @map("created_at")

  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@map("audit_logs")
}

model AiPrediction {
  id              String   @id @default(uuid()) @db.VarChar(36)
  branchId        String   @map("branch_id") @db.VarChar(36)
  productId       String   @map("product_id") @db.VarChar(36)
  predictionType  String   @map("prediction_type") @db.VarChar(50) // STOCK_FORECAST
  predictedValue  Decimal  @map("predicted_value") @db.Decimal(12, 2)
  confidenceScore Decimal  @map("confidence_score") @db.Decimal(5, 2)
  riskLevel       String   @map("risk_level") @db.VarChar(20) // LOW, MEDIUM, HIGH, CRITICAL
  recommendation  String   @db.Text
  rationale       String   @db.Text
  createdAt       DateTime @default(now()) @map("created_at")

  branch          Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  product         Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([branchId])
  @@index([productId])
  @@map("ai_predictions")
}

model AiInsight {
  id              String   @id @default(uuid()) @db.VarChar(36)
  category        String   @db.VarChar(50) // CUSTOMER_RFM, DRUG_INTERACTION, SALES_TREND
  title           String   @db.VarChar(150)
  summary         String   @db.Text
  insightDataJson String?  @map("insight_data_json") @db.LongText
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("ai_insights")
}
