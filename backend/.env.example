PORT=3001
APP_ENV=development
APP_NAME=PharmaPOS
API_PREFIX=api/v1
TZ=Asia/Jakarta

# MySQL / MariaDB via XAMPP
DATABASE_URL="mysql://root:@localhost:3306/pharmapos_db"

# JWT Authentication
JWT_SECRET=pharmapos_secure_super_secret_jwt_key_indonesia_2026
