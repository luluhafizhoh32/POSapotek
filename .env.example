# PharmaPOS Environment Variables Configuration
# Salin file ini menjadi .env baik di root maupun di folder backend/

# Server Configuration
PORT=3001
APP_ENV=development
APP_NAME=PharmaPOS
APP_URL=http://localhost:3001
API_PREFIX=api/v1
TZ=Asia/Jakarta

# Database Configuration (XAMPP MySQL / MariaDB)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
# Default XAMPP: user 'root' tanpa password pada port 3306
DATABASE_URL="mysql://root:@localhost:3306/pharmapos_db"
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=pharmapos_db

# Security & JWT Authentication
JWT_SECRET=pharmapos_secure_super_secret_jwt_key_indonesia_2026
JWT_EXPIRATION=86400s
JWT_REFRESH_SECRET=pharmapos_secure_refresh_token_secret_key_2026
JWT_REFRESH_EXPIRATION=604800s

# Pharmacy Business & Simulation Settings
DEFAULT_BRANCH_NAME="Apotek Sehat Sentosa"
ENABLE_SIMULATED_PAYMENT=true
ENABLE_SIMULATED_NOTIFICATION=true
QRIS_SIMULATED_MERCHANT="NMID123456789012"
FEFO_STRICT_MODE=true
